# dibaca cfm: satu .conf per port SOCKS5.
# Format minimal yang perlu:

[Socks5]
BindAddress = 127.0.0.1:1091

# Contoh lengkap dengan WireGuard (wireproxy):
#
# [Interface]
# Address = 10.14.0.2/16
# PrivateKey = <kunci-privat-anda>
# DNS = 162.252.172.57
#
# [Peer]
# PublicKey = <kunci-publik-server>
# AllowedIPs = 0.0.0.0/0
# Endpoint = sg-sng-st005.example.com:51820
#
# [Socks5]
# BindAddress = 127.0.0.1:1091
#
# Port harus unik per berkas. cfox-fullscreen.py dan cekproxy membaca direktori
# ~/surfshark-proxy/configs/ secara otomatis, jadi menambah berkas baru sudah cukup.