[Unit]
Description=WireGuard SOCKS5 proxies (wireproxy)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Pola glob *.conf membuat berkas baru otomatis ikut saat boot.
ExecStart=/bin/bash -c 'for c in %h/surfshark-proxy/configs/*.conf; do setsid bash -c "exec %h/.local/bin/wireproxy -c \"$c\" > %h/surfshark-proxy/logs/$(basename $c .conf).log 2>&1" < /dev/null & done; sleep 3'
ExecStop=/usr/bin/pkill -f "wireproxy -c"

[Install]
WantedBy=default.target