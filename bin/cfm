#!/usr/bin/env python3
"""
cfm - Camoufox Manager (interactive, arrow-key menus)

    $ cfm
    cfm> /new          -> wizard: name -> OS -> proxy  (arrow keys)
    cfm> /list
    cfm> /run acc1     -> without a port, an arrow-key menu appears
"""
import argparse, json, os as _os, pathlib, re, shutil, socket, subprocess, sys, random
from urllib.parse import quote, unquote

# Same as cfox: keep the Camoufox install outside ~/.cache so a routine
# 'rm -rf ~/.cache/*' cannot delete it.
if not _os.environ.get("XDG_CACHE_HOME"):
    _os.environ["XDG_CACHE_HOME"] = str(pathlib.Path(_os.environ.get("CAMOUFOX_HOME", pathlib.Path.home()/".local"/"share"/"camoufox")))

if not _os.environ.get("DISPLAY"):
    try:
        xs = sorted(pathlib.Path("/tmp/.X11-unix").iterdir())
        if xs: _os.environ["DISPLAY"] = ":" + xs[-1].name.lstrip("X")
    except Exception:
        pass

ROOT    = pathlib.Path.home() / "camfox-profiles"
CONFDIR = pathlib.Path.home() / "surfshark-proxy" / "configs"
PROXYURLDIR = CONFDIR  # *.url files with remote proxy URLs live next to wireproxy confs
VENV    = pathlib.Path.home() / ".camoufox-venv"
CFOX    = pathlib.Path.home() / ".local/bin/cfox"
HOTSPOT = 1080

# Profile names become directory names and appear in process cmdlines, so keep
# them to a safe charset (no '/', '..', spaces or shell metacharacters).
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
def valid_name(name):
    return bool(name) and bool(NAME_RE.match(name)) and ".." not in name
def bad_name(name):
    """Print an error and return True when the profile name is not allowed."""
    if valid_name(name): return False
    print(c(f"  invalid profile name {name!r} (allowed: letters, digits, . _ -)", C.RE))
    return True

def fonts_db():
    """Camoufox's bundled font list, located via the installed package."""
    import camoufox
    return json.loads((pathlib.Path(camoufox.__file__).parent / "fonts.json").read_text())

class C:
    R="\033[0m"; B="\033[1m"; D="\033[90m"
    G="\033[32m"; Y="\033[33m"; RE="\033[31m"; CY="\033[36m"; M="\033[35m"
def c(t, col): return f"{col}{t}{C.R}"

# ---------------- proxy ----------------
def port_open(p):
    try:
        with socket.create_connection(("127.0.0.1", int(p)), timeout=0.4): return True
    except Exception: return False

def discover_proxies():
    out = {}
    # The hotspot is ALWAYS listed, even when down, so it can still be saved
    # as a profile default.
    out["hotspot"] = {"port": HOTSPOT, "desc": "iPhone hotspot (Telkomsel)",
                      "alive": port_open(HOTSPOT)}
    if CONFDIR.exists():
        for f in sorted(CONFDIR.glob("*.conf")):
            t = f.read_text()
            m = re.search(r"BindAddress\s*=\s*127\.0\.0\.1:(\d+)", t)
            if not m: continue
            ep = re.search(r"Endpoint\s*=\s*([^\s:]+)", t)
            out[f.stem] = {"port": int(m.group(1)), "desc": (ep.group(1) if ep else "?")}
    return out

def proxy_choices(include_none=True):
    """Build the proxy choice list for the arrow-key menu."""
    items = []
    px = discover_proxies()
    for k, v in px.items():
        alive = v.get("alive", port_open(v["port"]))
        mark = "✓" if alive else "✗"
        items.append((f"{mark} {v['port']:>5}  {k:<18} {v['desc'][:34]}", v["port"]))
    # remote proxies: one *.url file per proxy in CONFDIR, contents = proxy URL
    for label, line in remote_proxies().items():
        alive = _url_alive(*_split_url(line))
        mark = "✓" if alive else "✗"
        items.append((f"{mark} remote {label:<18} {_mask_url(line)[:44]}", line))
    if include_none:
        items.append(("-  no proxy (use real IP!)", "__none__"))
    return items


def _split_url(url):
    m = re.match(r"^(https?|socks5)://(.*)$", url, re.I)
    scheme = m.group(1).lower() if m else "http"
    rest = m.group(2) if m else url
    if "@" in rest:
        userinfo, _, hostport = rest.rpartition("@")
    else:
        userinfo, hostport = "", rest
    return scheme, userinfo, hostport


def _mask_url(url):
    scheme, userinfo, hostport = _split_url(url)
    if userinfo:
        user = unquote(userinfo.split(":", 1)[0])
        return f"{scheme}://{user}:***@{hostport}" if ":" in userinfo else f"{scheme}://{user}@{hostport}"
    return url


def _curl_via(scheme, userinfo, hostport, target, timeout=9):
    """curl `target` through a remote proxy. Credentials go in via a curl
    config on stdin, so they never appear in argv (visible in ps)."""
    cfg = f'proxy = "{scheme}://{hostport}"\n'
    if userinfo:
        u, _, p = userinfo.partition(":")
        up = f"{unquote(u)}:{unquote(p)}".replace("\\", "\\\\").replace('"', '\\"')
        cfg += f'proxy-user = "{up}"\n'
    try:
        r = subprocess.run(["curl", "-s", "-m", str(timeout), "-K", "-", target],
                           input=cfg, capture_output=True, text=True, timeout=timeout + 5)
        return r.stdout.strip()
    except Exception:
        return ""


def _url_alive(scheme, userinfo, hostport, timeout=9):
    return bool(_curl_via(scheme, userinfo, hostport, "https://api.ipify.org", timeout))


def _url_info(url, timeout=12):
    """Exit IP details through a remote proxy, or None."""
    out = _curl_via(*_split_url(url),
                    "http://ip-api.com/json/?fields=query,country,city,isp,hosting", timeout)
    try: return json.loads(out) if out else None
    except Exception: return None


def remote_proxies():
    """{label: url} from CONFDIR/*.url (first non-comment line of each file)."""
    out = {}
    for f in sorted(PROXYURLDIR.glob("*.url")) if PROXYURLDIR.exists() else []:
        line = next((l.strip() for l in f.read_text().splitlines()
                     if l.strip() and not l.strip().startswith("#")), None)
        if line: out[f.stem] = line
    return out


def parse_proxy(text, default_scheme="http"):
    """Parse the formats proxy providers hand out (e.g. Webshare):
         host:port
         host:port:user:pass          (Webshare "download list" format)
         user:pass@host:port
         http://user:pass@host:port   socks5://host:port
    Returns dict(scheme, host, port, user, password) or raises ValueError."""
    t = text.strip()
    if not t: raise ValueError("empty")
    m = re.match(r"^(https?|socks5h?)://(.*)$", t, re.I)
    scheme = (m.group(1).lower() if m else default_scheme).replace("socks5h", "socks5")
    rest = m.group(2).rstrip("/") if m else t
    user = pw = ""
    parts = rest.split(":")
    if not m and len(parts) >= 4 and parts[1].isdigit():
        # host:port:user:pass - checked first, the password may contain '@'
        host, port = parts[0], parts[1]
        user, pw = parts[2], ":".join(parts[3:])
    elif "@" in rest:
        ui, _, hp = rest.rpartition("@")
        user, _, pw = ui.partition(":")
        host, _, port = hp.rpartition(":")
    elif len(parts) == 2:
        host, port = parts
    elif not m and len(parts) >= 4 and parts[-1].isdigit():   # user:pass:host:port
        host, port = parts[-2], parts[-1]
        user, pw = parts[0], ":".join(parts[1:-2])
    else:
        raise ValueError("expected host:port, host:port:user:pass or user:pass@host:port")
    return _check_proxy(dict(scheme=scheme, host=host.strip(), port=str(port).strip(),
                             user=unquote(user), password=unquote(pw)))


def _check_proxy(d):
    if d["scheme"] not in ("http", "https", "socks5"):
        raise ValueError(f"unsupported scheme {d['scheme']!r}")
    if not re.match(r"^[A-Za-z0-9.-]+$", d["host"] or ""):
        raise ValueError(f"invalid host {d['host']!r}")
    if not d["port"].isdigit() or not 0 < int(d["port"]) < 65536:
        raise ValueError(f"invalid port {d['port']!r}")
    if d["password"] and not d["user"]:
        raise ValueError("password given without a username")
    return d


def proxy_url(d):
    """Build the stored URL; credentials are percent-encoded so characters such
    as @ : / # in a password cannot break parsing."""
    auth = ""
    if d["user"]:
        auth = quote(d["user"], safe="")
        if d["password"]: auth += ":" + quote(d["password"], safe="")
        auth += "@"
    return f"{d['scheme']}://{auth}{d['host']}:{int(d['port'])}"


def save_remote_proxy(label, url):
    PROXYURLDIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    f = PROXYURLDIR / f"{label}.url"
    fd = _os.open(f, _os.O_WRONLY | _os.O_CREAT | _os.O_TRUNC, 0o600)
    with _os.fdopen(fd, "w") as fh:
        fh.write(url + "\n")
    _os.chmod(f, 0o600)      # also tighten a pre-existing file
    return f

def proxy_ip(port, timeout=9):
    try:
        r = subprocess.run(["curl","-s","-m",str(timeout),"--socks5-hostname",f"127.0.0.1:{port}",
                            "http://ip-api.com/json/?fields=query,country,city,isp,hosting"],
                           capture_output=True, text=True, timeout=timeout+5)
        return json.loads(r.stdout) if r.stdout.strip() else None
    except Exception: return None

# ---------------- profiles ----------------
def load(pdir):
    f = pdir / "fingerprint.json"
    return json.loads(f.read_text()) if f.exists() else None
def save(pdir, m):
    # may contain proxy credentials (proxy_url) -> owner-only
    f = pdir / "fingerprint.json"
    fd = _os.open(f, _os.O_WRONLY | _os.O_CREAT | _os.O_TRUNC, 0o600)
    with _os.fdopen(fd, "w") as fh: fh.write(json.dumps(m, indent=1))
    _os.chmod(f, 0o600)
def profiles():
    if not ROOT.exists(): return []
    out=[]
    for d in sorted(ROOT.iterdir()):
        if d.is_dir() and not d.name.startswith("_"):
            m = load(d)
            if m: out.append((d.name, m))
    return out
def label_for(port, px=None):
    px = px or discover_proxies()
    return next((k for k,v in px.items() if v["port"]==port), "?")

# ---------------- display ----------------
def show_list():
    rows = profiles()
    if not rows: print(c("  no profiles yet. type: /new", C.Y)); return
    px = discover_proxies(); rproxies = remote_proxies()
    print()
    print(c(f"  {'PROFILE':<10}{'OS':<9}{'PRESET':<13}{'CORES':<7}{'SCREEN':<12}{'PROXY':<26}STATUS", C.B))
    print(c("  " + "-"*92, C.D))
    for name, m in rows:
        p=m["preset"]; n=p.get("navigator",{}); s=p.get("screen",{})
        port=m.get("proxy_port")
        if m.get("proxy_url"):
            lab = next((k for k,u in rproxies.items() if u == m["proxy_url"]), None)
            ptxt = f"remote ({lab})" if lab else _mask_url(m["proxy_url"]).split("@")[-1]
            stat = c("remote", C.D)
        elif port == "__none__":
            ptxt = c("NO PROXY", C.Y) + " (real IP)"
            stat = ""
        elif port:
            ptxt = f"{port} ({label_for(port,px)})"
            stat = c("up",C.G) if port_open(port) else c("PROXY DOWN",C.RE)
        else:
            ptxt = c("-- not set --", C.D); stat = ""
        print(f"  {c(name,C.CY):<19}{m['os']:<9}{m['preset_id']:<13}"
              f"{str(n.get('hardwareConcurrency')):<7}"
              f"{str(s.get('width'))+'x'+str(s.get('height')):<12}{ptxt:<26}{stat}")
    print(c(f"\n  total {len(rows)} profiles", C.D))

def show_proxies(test=False):
    px = discover_proxies()
    print()
    print(c(f"  {'LABEL':<20}{'PORT':<8}{'STATUS':<11}", C.B) + c("DESCRIPTION", C.B))
    print(c("  " + "-"*74, C.D))
    for k,v in px.items():
        alive = port_open(v["port"])
        print(f"  {k:<20}{v['port']:<8}"
              f"{(c('up',C.G) if alive else c('DOWN',C.RE)):<20}{c(v['desc'],C.D)}")
    rp = remote_proxies()
    for k,u in rp.items():
        print(f"  {k:<20}{'remote':<8}{c('-',C.D):<20}{c(_mask_url(u),C.D)}")
    if test:
        print(c("\n  checking exit IPs...", C.D))
        checks = [(k, lambda v=v: proxy_ip(v["port"])) for k,v in px.items()]
        checks += [(k, lambda u=u: _url_info(u)) for k,u in rp.items()]
        for k, fn in checks:
            d = fn()
            if d:
                flag = c(" [DC]",C.Y) if d.get("hosting") else ""
                print(f"    {k:<20} {c(d.get('query','?'),C.G):<27}{d.get('country')}/{d.get('city')}{flag}")
            else: print(f"    {k:<20} {c('failed',C.RE)}")
    if not rp:
        print(c("\n  add a remote proxy (e.g. Webshare) with /addproxy", C.D))
    print()

def show_help():
    print(f"""
{c('  Camoufox Manager',C.B)} {c('- commands (all also reachable from the arrow menu)',C.D)}

  {c('/new',C.CY)} [name]        wizard: name -> OS -> proxy (arrow keys)
  {c('/list',C.CY)}              list profiles and their proxy
  {c('/proxies',C.CY)} [--test]  list proxies; --test checks the exit IP
  {c('/run',C.CY)} [name]        run (arrow menu for profile and proxy when omitted)
  {c('/proxy',C.CY)} [name]      set the profile's default proxy (arrow menu)
  {c('/addproxy',C.CY)} [label]  add a remote proxy: host, port, user, password
                      (or paste host:port:user:pass / user:pass@host:port)
  {c('/rmproxy',C.CY)} [label]   delete a remote proxy
  {c('/info',C.CY)} <name>       show UA/GPU/screen/cores detail
  {c('/newfp',C.CY)} <name>      regenerate fingerprint (profile and proxy kept)
  {c('/newname',C.CY)} <old> <new>   rename a profile
  {c('/rm',C.CY)} [name]         delete a profile
  {c('/help',C.CY)}   {c('/quit',C.CY)}        help / quit

  {c('tab',C.D)}=autocomplete  {c('↑ ↓',C.D)}=history  {c('← →',C.D)}=menu
""")

# ---------------- actions ----------------
def _ask(q):
    """questionary wrapper - returns None when not running on a TTY."""
    import questionary
    if not sys.stdin.isatty():
        return None
    return q.ask()

def act_new(args):
    import questionary
    # 1. name
    if args and not args[0].startswith("-"):
        name = args[0]
        rest = args[1:]
    else:
        name = _ask(questionary.text("Profile name:"))
        if not name: print(c("  cancelled", C.Y)); return
        name = name.strip()
        rest = args
    if bad_name(name): return
    if (ROOT/name/"fingerprint.json").exists():
        print(c(f"  profile '{name}' already exists", C.Y)); return

    # 2. OS
    os_name = None
    if "--os" in rest:
        i = rest.index("--os")
        if i+1 < len(rest): os_name = rest[i+1]
    if not os_name:
        os_name = _ask(questionary.select(
            "Choose an OS (the fingerprint follows):",
            choices=[questionary.Choice("Windows 10/11  (most common)", "windows"),
                     questionary.Choice("macOS          (Apple M1/Intel)", "macos"),
                     questionary.Choice("Linux          (least common)", "linux")]))
        if not os_name: print(c("  cancelled", C.Y)); return

    # 3. proxy
    port = None
    if "--port" in rest:
        i = rest.index("--port")
        if i+1 < len(rest) and rest[i+1].isdigit(): port = int(rest[i+1])
    if port is None and "--noproxy" not in rest:
        items = proxy_choices()
        labels = [x[0] for x in items]
        sel = _ask(questionary.select(
            "Choose a proxy:", choices=[questionary.Choice(l, v) for l, v in items]))
        if sel is None:
            print(c("  cancelled", C.Y)); return
        port = None if sel == "__none__" else sel

    # 4. create
    pdir = ROOT/name; pdir.mkdir(parents=True, exist_ok=True)
    from camoufox.fingerprints import load_presets
    pres = load_presets().get("presets", {})
    vf = ROOT/"_valid.json"
    valid = json.loads(vf.read_text()) if vf.exists() else None
    pool = pres[os_name]
    good = (valid or {}).get(os_name) or list(range(len(pool)))
    used = {m.get("preset_id") for _,m in profiles()}
    avail = [i for i in good if f"{os_name}:{i}" not in used] or good
    i = random.choice(avail)
    FONTS = fonts_db()
    omap = {"windows":"win","macos":"mac","linux":"lin"}
    rng = random.Random(f"{os_name}:{i}")
    fl = FONTS[omap[os_name]]
    n = rng.randint(180,320) if omap[os_name]=="mac" else rng.randint(55,85)
    preset = dict(pool[i]); preset["fonts"] = sorted(rng.sample(fl, min(n,len(fl))))
    meta = {"profile":name, "os":os_name, "preset_id":f"{os_name}:{i}", "preset":preset,
            "proxy_port": "__none__" if port is None else int(port)}
    save(pdir, meta)

    nv = preset.get("navigator",{}); sc = preset.get("screen",{}); wg = preset.get("webgl",{})
    print(c(f"\n  profile '{name}' created", C.G))
    print(f"    os       : {os_name}  ({os_name}:{i})")
    print(f"    cores    : {nv.get('hardwareConcurrency')}   screen: {sc.get('width')}x{sc.get('height')}")
    print(f"    GPU      : {str(wg.get('unmaskedRenderer'))[:60]}")
    print(f"    fonts    : {len(preset['fonts'])}")
    print(f"    proxy    : {port or 'NO PROXY (real IP!)'}")
    if port: print(c(f"\n  run with: /run {name}", C.D))


def act_proxy(args):
    import questionary
    name = args[0] if args else _ask(questionary.select(
        "Choose a profile:", choices=[n for n,_ in profiles()]))
    if not name: print(c("  cancelled",C.Y)); return
    if bad_name(name): return
    m = load(ROOT/name)
    if not m: print(c(f"  profile '{name}' does not exist", C.RE)); return
    if len(args) > 1 and str(args[1]).lower() in ("none","noproxy","off","-"):
        m["proxy_port"] = "__none__"; m.pop("proxy_url", None); save(ROOT/name, m)
        print(c(f"  ✓ {name} → default: NO PROXY (real IP)",C.Y)); return
    if len(args) > 1 and str(args[1]).isdigit():
        sel = int(args[1])
    elif len(args) > 1 and str(args[1]).lower() not in ("none","noproxy","off","-"):
        # remote proxy URL given directly, e.g. /proxy name http://user:pass@host:port
        # or path to a .url file
        raw = str(args[1])
        if raw in remote_proxies():
            raw = remote_proxies()[raw]            # label added with /addproxy
        elif not re.match(r"^(https?|socks5)://", raw):
            f = pathlib.Path(raw).expanduser()
            if f.is_file():
                raw = next((l.strip() for l in f.read_text().splitlines()
                            if l.strip() and not l.startswith("#")), "")
                if not raw: print(c("  no proxy URL found in file", C.RE)); return
            else:
                # provider formats: host:port:user:pass, user:pass@host:port
                try: raw = proxy_url(parse_proxy(raw))
                except ValueError as e: print(c(f"  {e}", C.RE)); return
        m["proxy_url"] = raw; m.pop("proxy_port", None); save(ROOT/name, m)
        sch, ui, hp = _split_url(raw)
        print(c(f"  ✓ {name} → {_mask_url(raw)}", C.G) +
              ("" if _url_alive(sch, ui, hp) else c("  [proxy DOWN?]", C.RE)))
        return
    else:
        items = proxy_choices()
        sel = _ask(questionary.select(f"Proxy for {name}:",
                    choices=[questionary.Choice(l, v) for l,v in items]))
    # normalize the two kinds of selection
    if isinstance(sel, str) and re.match(r"^(https?|socks5)://", sel):
        m["proxy_url"] = sel; m.pop("proxy_port", None); save(ROOT/name, m)
        sch, ui, hp = _split_url(sel)
        print(c(f"  ✓ {name} → {_mask_url(sel)}", C.G) +
              ("" if _url_alive(sch, ui, hp) else c("  [proxy DOWN?]", C.RE)))
        return
    port = sel
    if port == "__none__" or port is None:
        if port is None:
            print(c("  cancelled",C.Y)); return
    if port == "__none__":
        m["proxy_port"] = "__none__"; m.pop("proxy_url", None); save(ROOT/name, m)
        print(c(f"  ✓ {name} → default: NO PROXY (real IP)",C.Y)); return
    m["proxy_port"] = int(port); m.pop("proxy_url", None); save(ROOT/name, m)
    print(c(f"  ✓ {name} → {port}",C.G) +
          ("" if port_open(port) else c("  [port DOWN]", C.RE)) +
          c(f"  ({label_for(int(port))})", C.D))


def act_run(args):
    """Run a profile. Without a port argument it ALWAYS asks, offering the saved default."""
    import questionary
    # --- choose a profile ---
    if args and not args[0].startswith("-"):
        name, rest = args[0], args[1:]
    else:
        rows = profiles()
        if not rows: print(c("  no profiles yet",C.Y)); return
        sel = _ask(questionary.select("Choose a profile:",
            choices=[f"{n}  ({m['os']} {m['preset_id']} → {_ptext(m.get('proxy_port'))})"
                     for n,m in rows]))
        if sel is None: print(c("  cancelled",C.Y)); return
        name = sel.split()[0]; rest = args
    if bad_name(name): return
    m = load(ROOT/name)
    if not m: print(c(f"  profile '{name}' does not exist", C.RE)); return

    bg = "--bg" in rest
    # --- fast path (non-interactive) ---
    digits = [a for a in rest if str(a).isdigit()]
    urlargs = [a for a in rest if re.match(r"^(https?|socks5)://", str(a)) or
               (pathlib.Path(str(a)).expanduser().exists() and
                str(a).endswith((".url",".txt",".conf")) and
                any(l.strip().startswith(("http://","https://","socks5://"))
                    for l in pathlib.Path(str(a)).expanduser().read_text().splitlines()))]
    forced_none = any(str(a).lower() in ("none","noproxy","--noproxy","off") for a in rest)
    if forced_none:
        m["proxy_port"] = "__none__"; m.pop("proxy_url", None); save(ROOT/name, m)
        return _launch(name, m, None, bg)
    if urlargs:
        raw = str(urlargs[0])
        if not re.match(r"^(https?|socks5)://", raw):
            raw = next((l.strip() for l in pathlib.Path(raw).expanduser().read_text().splitlines()
                        if l.strip().startswith(("http://","https://","socks5://"))), "")
        if raw:
            m["proxy_url"] = raw; m.pop("proxy_port", None); save(ROOT/name, m)
            return _launch(name, m, raw, bg)
    if digits:
        port = int(digits[0])
        m["proxy_port"] = port; m.pop("proxy_url", None); save(ROOT/name, m)
        return _launch(name, m, port, bg)
    if not rest and m.get("proxy_url"):
        # stored remote default
        return _launch(name, m, m["proxy_url"], bg)

    # --- interactive: ALWAYS ask, with the saved default at the top ---
    saved_port = m.get("proxy_port")
    saved_url = m.get("proxy_url")
    items = []
    if saved_url:
        items.append((f"* use this profile's DEFAULT  ->  {_mask_url(saved_url)}", "DEFAULT"))
    elif saved_port is not None:
        items.append((f"* use this profile's DEFAULT  ->  {_ptext(saved_port, full=True)}", "DEFAULT"))
    for lab, val in proxy_choices(include_none=True):
        items.append((lab, val))
    # Non-TTY (script/pipe): use the saved default without a menu
    if not sys.stdin.isatty():
        if saved_url:
            print(c(f"  (non-interactive: using {_mask_url(saved_url)})", C.D))
            return _launch(name, m, saved_url, bg)
        port = None if (saved_port is None or saved_port == "__none__") else saved_port
        print(c(f"  (non-interactive: using {_ptext(saved_port, full=True)})", C.D))
        return _launch(name, m, port, bg)

    sel = _ask(questionary.select(f"Proxy for {name}:",
                choices=[questionary.Choice(l, v) for l,v in items]))
    if sel is None: print(c("  cancelled",C.Y)); return

    if sel == "DEFAULT":
        if saved_url:
            return _launch(name, m, saved_url, bg)
        port = None if saved_port == "__none__" else saved_port
    elif sel == "__none__":
        port = None
        m["proxy_port"] = "__none__"; m.pop("proxy_url", None); save(ROOT/name, m)
    elif isinstance(sel, str) and re.match(r"^(https?|socks5)://", sel):
        m["proxy_url"] = sel; m.pop("proxy_port", None); save(ROOT/name, m)
        return _launch(name, m, sel, bg)
    else:
        port = sel
        m["proxy_port"] = int(port); m.pop("proxy_url", None); save(ROOT/name, m)
    return _launch(name, m, port, bg)


def _ptext(v, full=False):
    """Human-readable proxy status."""
    if v == "__none__": return c("NO PROXY", C.Y) + (c(" (real IP)", C.RE) if full else "")
    if v: return str(v)
    return "not set"


def _launch(name, m, port, bg):
    """Launch cfox, with or without a proxy. `port` may be an int (local
    wireproxy port) or a proxy URL string (remote HTTP/SOCKS5)."""
    if bad_name(name): return
    nv=m["preset"].get("navigator",{}); sc=m["preset"].get("screen",{})
    dim=f"{sc.get('width')}x{sc.get('height')}  {nv.get('hardwareConcurrency')}c"
    # cfox needs the camoufox module: prefer the venv interpreter, because
    # sys.executable may be a system python that lacks it.
    vpy = VENV / "bin" / "python"
    py = str(vpy) if vpy.exists() else sys.executable
    env = {**_os.environ, "CFM_LAUNCHED": "1"}
    if port is None:
        print(c(f"  ▶ {name}", C.Y) + f"  {m['os']} {m['preset_id']}  {dim}  → "
              + c("NO PROXY (real IP!)", C.RE))
        # explicit --noproxy: cfox would otherwise fall back to the saved default
        cmd = [py, str(CFOX), name, "--noproxy"]
    elif isinstance(port, str) and re.match(r"^(https?|socks5)://", port):
        # Remote proxy URL. It is already saved as the profile default, so cfox
        # reads it from fingerprint.json - the password never appears in argv
        # (visible to every user via ps / /proc/<pid>/cmdline).
        if (load(ROOT/name) or {}).get("proxy_url") != port:
            m["proxy_url"] = port; m.pop("proxy_port", None); save(ROOT/name, m)
        print(c(f"  ▶ {name}", C.G) + f"  {m['os']} {m['preset_id']}  {dim}  "
              f"→ {_mask_url(port)} (remote)")
        cmd = [py, str(CFOX), name]
    else:
        if not port_open(port):
            print(c(f"  port {port} is DOWN - run: ss-up", C.RE)); return
        print(c(f"  ▶ {name}", C.G) + f"  {m['os']} {m['preset_id']}  {dim}  "
              f"→ {port} ({label_for(int(port))})")
        cmd = [py, str(CFOX), name, "--port", str(int(port))]
    if bg:
        # No shell: argv is passed as a list. The log lives in the (private)
        # profiles dir instead of a predictable world-readable /tmp path.
        logdir = ROOT / "_logs"
        logdir.mkdir(mode=0o700, parents=True, exist_ok=True)
        logf = logdir / f"{name}.log"
        fd = _os.open(logf, _os.O_WRONLY | _os.O_CREAT | _os.O_APPEND, 0o600)
        with _os.fdopen(fd, "ab") as log:
            subprocess.Popen(cmd, env=env, stdin=subprocess.DEVNULL, stdout=log,
                             stderr=subprocess.STDOUT, start_new_session=True)
        print(c(f"    background - log: {logf}", C.D))
    else:
        subprocess.run(cmd, env=env)


def act_newfp(args):
    """Regenerate the fingerprint; profile name and proxy are kept."""
    import questionary
    name = args[0] if args else _ask(questionary.select("Regenerate fingerprint for profile:",
                choices=[n for n,_ in profiles()]))
    if not name: print(c("  cancelled",C.Y)); return
    if bad_name(name): return
    pdir = ROOT/name; m = load(pdir)
    if not m: print(c(f"  profile '{name}' does not exist", C.RE)); return
    os_name = None
    if "--os" in args:
        i = args.index("--os")
        if i+1 < len(args): os_name = args[i+1]
    if not os_name:
        os_name = _ask(questionary.select("New OS:",
                    choices=[questionary.Choice(f"{o} (currently: {m['os']})", o)
                             for o in ["windows","macos","linux"]]))
        if not os_name: print(c("  cancelled",C.Y)); return
    from camoufox.fingerprints import load_presets
    pres = load_presets().get("presets", {})
    vf = ROOT/"_valid.json"
    valid = json.loads(vf.read_text()) if vf.exists() else None
    good = (valid or {}).get(os_name) or list(range(len(pres[os_name])))
    used = {mm.get("preset_id") for n,mm in profiles() if n != name}
    avail = [i for i in good if f"{os_name}:{i}" not in used] or good
    i = random.choice(avail)
    FONTS = fonts_db()
    omap = {"windows":"win","macos":"mac","linux":"lin"}
    rng = random.Random(f"{os_name}:{i}-{random.randint(0,9999)}")
    fl = FONTS[omap[os_name]]
    n = rng.randint(180,320) if omap[os_name]=="mac" else rng.randint(55,85)
    preset = dict(pres[os_name][i]); preset["fonts"] = sorted(rng.sample(fl, min(n,len(fl))))
    old = m.get("preset_id")
    m.update({"os":os_name, "preset_id":f"{os_name}:{i}", "preset":preset})
    save(pdir, m)
    print(c(f"  {name}: fingerprint regenerated", C.G))
    print(f"    {old}  ->  {os_name}:{i}   proxy kept {m.get('proxy_port')}")


def act_info(args):
    import questionary
    name = args[0] if args else _ask(questionary.select("Show profile detail:",
                choices=[n for n,_ in profiles()]))
    if not name or bad_name(name): return
    m = load(ROOT/name)
    if not m: print(c("  profile does not exist", C.RE)); return
    p=m["preset"]; nv=p.get("navigator",{}); sc=p.get("screen",{}); wg=p.get("webgl",{})
    print(f"""
  {c('profile',C.B)}   : {name}
  {c('os',C.B)}        : {m['os']}   preset={m['preset_id']}
  {c('UA',C.B)}        : {nv.get('userAgent')}
  {c('platform',C.B)}  : {nv.get('platform')}   cores={nv.get('hardwareConcurrency')}
  {c('screen',C.B)}    : {sc.get('width')}x{sc.get('height')}  avail={sc.get('availWidth')}x{sc.get('availHeight')}
  {c('GPU',C.B)}       : {wg.get('unmaskedRenderer') or wg.get('renderer')}
  {c('fonts',C.B)}     : {len(p.get('fonts',[]))}
  {c('proxy',C.B)}     : {'NO PROXY (real IP)' if m.get('proxy_port')=='__none__' else (m.get('proxy_port') or 'not set')}
""")


def act_rm(args):
    import questionary
    name = args[0] if args else _ask(questionary.select("Delete profile:",
                choices=[n for n,_ in profiles()]))
    if not name or bad_name(name): return
    d = ROOT/name
    if not (d/"fingerprint.json").exists(): print(c("  profile does not exist", C.RE)); return
    ok = _ask(questionary.confirm(f"Delete '{name}'?", default=False))
    if not ok: print(c("  cancelled",C.Y)); return
    shutil.rmtree(d); print(c(f"  {name} deleted", C.G))


def act_newname(args):
    if len(args)<2: print(c("  usage: /newname <old> <new>", C.Y)); return
    if bad_name(args[0]) or bad_name(args[1]): return
    a,b = ROOT/args[0], ROOT/args[1]
    if not (a/"fingerprint.json").exists(): print(c("  source profile does not exist", C.RE)); return
    if (b/"fingerprint.json").exists(): print(c("  new name is already taken", C.RE)); return
    a.rename(b); m=load(b); m["profile"]=args[1]; save(b,m)
    print(c(f"  ✓ {args[0]} → {args[1]}", C.G))


def act_addproxy(args):
    """Add a remote proxy (Webshare etc.): paste it, or fill in the fields."""
    import questionary
    tty = sys.stdin.isatty()
    # 1. label
    label = args[0] if args else _ask(questionary.text(
        "Label for this proxy (e.g. webshare-us1):"))
    if not label: print(c("  cancelled", C.Y)); return
    label = label.strip()
    if not valid_name(label):
        print(c(f"  invalid label {label!r} (allowed: letters, digits, . _ -)", C.RE)); return
    if (PROXYURLDIR / f"{label}.conf").exists():
        print(c(f"  '{label}' is already a wireproxy config", C.RE)); return
    if label in remote_proxies() and tty:
        if not _ask(questionary.confirm(f"'{label}' exists - overwrite?", default=False)):
            print(c("  cancelled", C.Y)); return

    # 2. the proxy itself
    if len(args) > 1:
        # non-interactive: cfm addproxy <label> <host:port:user:pass | URL>
        # (note: this puts the password in your shell history)
        try: d = parse_proxy(args[1])
        except ValueError as e: print(c(f"  {e}", C.RE)); return
    else:
        if not tty: print(c("  usage: cfm addproxy <label> <proxy>", C.Y)); return
        pasted = _ask(questionary.text(
            "Paste proxy (host:port:user:pass, user:pass@host:port or URL)\n"
            "  or press ENTER to fill in the fields one by one:"))
        if pasted is None: print(c("  cancelled", C.Y)); return
        if pasted.strip():
            try: d = parse_proxy(pasted)
            except ValueError as e: print(c(f"  {e}", C.RE)); return
        else:
            scheme = _ask(questionary.select("Type:", choices=[
                questionary.Choice("HTTP    (recommended, works with username/password)", "http"),
                questionary.Choice("SOCKS5  (only WITHOUT username/password)", "socks5")]))
            if not scheme: print(c("  cancelled", C.Y)); return
            host = _ask(questionary.text("Host / IP:", validate=lambda v:
                        bool(re.match(r"^[A-Za-z0-9.-]+$", v.strip())) or "letters, digits, . and - only"))
            if not host: print(c("  cancelled", C.Y)); return
            port = _ask(questionary.text("Port:", validate=lambda v:
                        (v.strip().isdigit() and 0 < int(v) < 65536) or "1-65535"))
            if not port: print(c("  cancelled", C.Y)); return
            user = _ask(questionary.text("Username (empty = none):")) or ""
            pw = _ask(questionary.password("Password:")) if user.strip() else ""
            try: d = _check_proxy(dict(scheme=scheme, host=host.strip(), port=port.strip(),
                                       user=user.strip(), password=pw or ""))
            except ValueError as e: print(c(f"  {e}", C.RE)); return

    # Firefox cannot authenticate to SOCKS5 proxies (Mozilla bug 122752), so
    # an authenticated SOCKS5 proxy would silently fail in the browser.
    if d["scheme"] == "socks5" and d["user"]:
        print(c("  Firefox/Camoufox cannot log in to a SOCKS5 proxy with a username/password.", C.Y))
        print(c("  Most providers (Webshare included) accept HTTP with the same credentials.", C.D))
        if tty and not _ask(questionary.confirm("Use HTTP instead?", default=True)):
            print(c("  cancelled", C.Y)); return
        d["scheme"] = "http"

    url = proxy_url(d)
    # 3. test
    print(c(f"  testing {_mask_url(url)} ...", C.D))
    info = _url_info(url)
    if info:
        flag = c(" [DC]", C.Y) if info.get("hosting") else ""
        print(c("  ✓ works", C.G) + f"  exit IP {info.get('query')}  "
              f"{info.get('country')}/{info.get('city')}  {str(info.get('isp',''))[:30]}{flag}")
    else:
        print(c("  ✗ no response through this proxy (wrong credentials/port, or IP not whitelisted?)", C.RE))
        if tty and not _ask(questionary.confirm("Save it anyway?", default=False)):
            print(c("  not saved", C.Y)); return

    # 4. save (mode 0600: the file holds the password)
    f = save_remote_proxy(label, url)
    print(c(f"  ✓ saved as '{label}'", C.G) + c(f"  ({f})", C.D))

    # 5. optionally make it a profile's default
    rows = profiles()
    if tty and rows:
        who = _ask(questionary.select("Use it as the default proxy for a profile?",
                   choices=[questionary.Choice("no, just save it", "")] +
                           [questionary.Choice(f"{n}  (now: {_ptext(m.get('proxy_port')) if not m.get('proxy_url') else _mask_url(m['proxy_url'])})", n)
                            for n, m in rows]))
        if who:
            m = load(ROOT/who)
            m["proxy_url"] = url; m.pop("proxy_port", None); save(ROOT/who, m)
            print(c(f"  ✓ {who} → {label}", C.G))


def act_rmproxy(args):
    import questionary
    rp = remote_proxies()
    if not rp: print(c("  no remote proxies", C.Y)); return
    label = args[0] if args else _ask(questionary.select("Delete remote proxy:", choices=list(rp)))
    if not label: print(c("  cancelled", C.Y)); return
    if label not in rp or not valid_name(label):
        print(c(f"  remote proxy '{label}' does not exist", C.RE)); return
    users = [n for n, m in profiles() if m.get("proxy_url") == rp[label]]
    if users: print(c(f"  still the default of: {', '.join(users)} (they keep their own copy)", C.Y))
    if sys.stdin.isatty() and not _ask(questionary.confirm(f"Delete '{label}'?", default=False)):
        print(c("  cancelled", C.Y)); return
    (PROXYURLDIR / f"{label}.url").unlink()
    print(c(f"  ✓ {label} deleted", C.G))


# ---------------- TUI ----------------
COMMANDS = ["/new","/list","/proxies","/run","/proxy","/addproxy","/rmproxy","/info","/newfp","/newname","/rm","/help","/quit"]

def complete_names(prefix):
    try:
        p = prefix.split()
        if len(p) <= 1:
            return [x for x in COMMANDS if x.startswith(prefix)]
        if p[0] in ("/run","/proxy","/info","/rm","/newfp","/newname"):
            return [" ".join(p[:-1]+[o]) for o in
                    [n for n,_ in profiles() if n.startswith(p[-1])]]
        if p[0]=="/rmproxy":
            return [f"/rmproxy {k}" for k in remote_proxies() if k.startswith(p[-1])]
        if p[0]=="/proxies":
            return ["/proxies","/proxies --test"]
    except Exception: pass
    return []

def interactive():
    from prompt_toolkit import PromptSession
    from prompt_toolkit.completion import Completer, Completion
    from prompt_toolkit.history import InMemoryHistory
    from prompt_toolkit.formatted_text import ANSI

    class CC(Completer):
        def get_completions(self, doc, ev):
            txt = doc.text
            for s in complete_names(txt):
                yield Completion(s, start_position=-len(txt))

    session = PromptSession(history=InMemoryHistory(), completer=CC(), complete_while_typing=True)
    print(f"""
{c('  ╭────────────────────────────────────────────╮',C.CY)}
{c('  │',C.CY)}  {c('Camoufox Manager',C.B)}   {c('· cfm',C.D)}                    {c('│',C.CY)}
{c('  ╰────────────────────────────────────────────╯',C.CY)}
  {c('/new',C.CY)} new profile   {c('/run',C.CY)} launch      {c('/list',C.CY)} list
  {c('/proxy',C.CY)} set proxy   {c('/proxies',C.CY)} test proxy  {c('/addproxy',C.CY)} add proxy
  {c('/help',C.CY)} help
  {c('tab',C.D)}=autocomplete   {c('↑↓',C.D)}=history   {c('←→',C.D)}=menu
""")
    dispatch = {
        "/list": lambda a: show_list(),
        "/proxies": lambda a: show_proxies("--test" in a),
        "/new": act_new, "/run": act_run, "/proxy": act_proxy, "/info": act_info,
        "/newfp": act_newfp, "/rm": act_rm, "/newname": act_newname,
        "/addproxy": act_addproxy, "/rmproxy": act_rmproxy,
        "/help": lambda a: show_help(),
        "/quit": lambda a: None,
    }
    while True:
        try:
            line = session.prompt(ANSI(c("cfm",C.M)+c("> ",C.D))).strip()
        except (EOFError, KeyboardInterrupt):
            print(); break
        if not line: continue
        if line in ("/quit","/exit","exit","quit"): break
        p = line.split(); cmd, args = p[0], p[1:]
        fn = dispatch.get(cmd)
        if not fn and cmd.startswith("/"):
            # exact match wins; otherwise resolve a unique abbreviation
            if cmd not in dispatch:
                cand = [k for k in dispatch if k.startswith(cmd)]
                # /p and /pro are ambiguous between proxy and proxies
                if len(cand) == 1:
                    cmd = cand[0]; fn = dispatch[cmd]
                    print(c(f"  → {cmd}", C.D))
                elif len(cand) > 1:
                    # pick the shortest candidate (usually the intended one)
                    cmd = min(cand, key=len); fn = dispatch[cmd]
                    others = [k for k in cand if k != cmd]
                    print(c(f"  → {cmd}", C.D) + c(f"   (others: {', '.join(sorted(others))})", C.D))
        if not fn:
            print(c(f"  unknown command '{cmd}'.  /help",C.Y)); continue
        if cmd == "/quit": break
        try: fn(args)
        except Exception as e:
            print(c(f"  error: {type(e).__name__}: {e}", C.RE))


def main():
    ap = argparse.ArgumentParser(prog="cfm")
    ap.add_argument("cmd", nargs="?"); ap.add_argument("args", nargs="*")
    ap.add_argument("--os", choices=["windows","macos","linux"])
    ap.add_argument("--port", type=int); ap.add_argument("--bg", action="store_true")
    ap.add_argument("--test", action="store_true"); ap.add_argument("--noproxy", action="store_true")
    a = ap.parse_args()
    if not a.cmd: interactive(); return
    extra = []
    if a.os: extra += ["--os", a.os]
    if a.port: extra += ["--port", str(a.port)]
    if a.noproxy: extra += ["--noproxy"]
    d = {"list": lambda: show_list(),
         "proxies": lambda: show_proxies(a.test),
         "new": lambda: act_new(a.args + extra),
         "run": lambda: act_run(a.args + ([str(a.port)] if a.port else [])
                                + (["--noproxy"] if a.noproxy else [])
                                + (["--bg"] if a.bg else [])),
         "proxy": lambda: act_proxy(a.args), "set": lambda: act_proxy(a.args),
         "info": lambda: act_info(a.args), "newfp": lambda: act_newfp(a.args + extra),
         "rm": lambda: act_rm(a.args), "newname": lambda: act_newname(a.args),
         "addproxy": lambda: act_addproxy(a.args), "rmproxy": lambda: act_rmproxy(a.args)}
    fn = d.get(a.cmd)
    if not fn: print(f"unknown command: {a.cmd}"); show_help(); return
    fn()

if __name__ == "__main__":
    main()
