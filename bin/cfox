#!/usr/bin/env python3
"""
Camoufox multi-profile launcher.

1 profile = 1 PERMANENT fingerprint (chosen from 123 real-device presets).
The fingerprint is picked once at profile creation, saved, then reused on every
run. Each profile gets a different, consistent hardware/GPU/screen/UA.

  cfox acc1                          # run with the profile's saved proxy
  cfox acc1 --port 1091              # create or reuse profile acc1, save port 1091
  cfox acc1 --noproxy                # run without a proxy (real IP), save that
  cfox acc1 --proxy http://user:pass@host:port   # remote proxy (HTTP/SOCKS5)
  cfox acc1 --proxy-file ~/proxy.txt            # proxy URL from a file (no history leak)
  cfox acc1 --new                    # regenerate the fingerprint (proxy kept)
  cfox acc1 --show                   # print the stored identity
  cfox --list                        # list all profiles
"""
import argparse, json, os as _os, pathlib, sys, secrets, random, re
from urllib.parse import quote, unquote

# --- Keep the Camoufox install OUT of ~/.cache -------------------------------
# That path is treated as disposable, and a routine 'rm -rf ~/.cache/*' removes
# the ~1.3 GB browser install. Default: ~/.local/share/camoufox
# Always point XDG_CACHE_HOME at the durable install dir so that
# platformdirs.user_cache_dir('camoufox') resolves to CAMO_HOME/camoufox.
# (Only CAMOUFOX_HOME can override this.)
_os.environ["XDG_CACHE_HOME"] = str(pathlib.Path(
    _os.environ.get("CAMOUFOX_HOME")
    or pathlib.Path.home() / ".local" / "share" / "camoufox"))

# Make sure DISPLAY is set (required for headful mode).
if sys.platform.startswith("linux") and not _os.environ.get("DISPLAY"):
    for _d in ("/tmp/.X11-unix",):
        try:
            xs = sorted(pathlib.Path(_d).iterdir())
            if xs:
                _os.environ["DISPLAY"] = ":" + xs[-1].name.lstrip("X")
        except Exception:
            pass

from camoufox.sync_api import Camoufox
from camoufox.fingerprints import load_presets, get_random_preset

# Optional pack of extra real GPUs (extras/gpus.json). Absent on a plain
# install, so cfox stays usable without it.
try:
    from cfm_gpu import extra_presets, install_sample_webgl_patch
except Exception:
    extra_presets = None
    install_sample_webgl_patch = None

# Per-profile noise for the WebGL pixel readback path (AF-006). Optional: cfox
# still works when this file is missing.
try:
    import cfm_readpixels
except Exception:
    cfm_readpixels = None

ROOT = pathlib.Path.home() / "camfox-profiles"
OS_LIST = ["windows", "macos", "linux"]
CAMO_HOME = pathlib.Path(
    _os.environ.get("CAMOUFOX_HOME", pathlib.Path.home() / ".local" / "share" / "camoufox")
)


def camo_ready():
    """Check that the Camoufox binary exists. Returns (ok, message)."""
    candidates = []
    try:
        from camoufox.pkgman import INSTALL_DIR, LAUNCH_FILE, OS_NAME
        from camoufox.multiversion import get_active_path
        active = get_active_path()
        if active:
            candidates.append(pathlib.Path(active) / LAUNCH_FILE[OS_NAME])
        candidates.append(pathlib.Path(INSTALL_DIR) / LAUNCH_FILE[OS_NAME])
    except Exception:
        pass

    cfg = CAMO_HOME / "camoufox" / "config.json"
    config_error = False
    if cfg.exists():
        try:
            active = json.loads(cfg.read_text()).get("active_version", "")
            binary = "camoufox.exe" if _os.name == "nt" else "camoufox-bin"
            candidates.append(CAMO_HOME / "camoufox" / active / binary)
        except Exception:
            config_error = True

    for binary in candidates:
        if binary.exists():
            return True, str(binary)
    if config_error and not candidates:
        return False, "config.json is corrupt"
    expected = candidates[0] if candidates else cfg.parent
    return False, f"binary missing: {expected}"


# Profile names become directory names and appear in process cmdlines, so keep
# them to a safe charset (no '/', '..', spaces or shell metacharacters).
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")


def valid_name(name) -> bool:
    return bool(name) and bool(NAME_RE.match(name)) and ".." not in name


def write_meta(fpath, meta):
    """fingerprint.json may hold proxy credentials (proxy_url) -> owner-only."""
    fd = _os.open(fpath, _os.O_WRONLY | _os.O_CREAT | _os.O_TRUNC, 0o600)
    with _os.fdopen(fd, "w") as fh:
        fh.write(json.dumps(meta, indent=1))
    _os.chmod(fpath, 0o600)


def saved_port(meta):
    """The profile's saved local proxy port, or None (unset / '__none__')."""
    p = meta.get("proxy_port")
    return int(p) if isinstance(p, int) or (isinstance(p, str) and p.isdigit()) else None


OSMAP = {"windows": "win", "macos": "mac", "linux": "lin"}
VALID_CACHE = ROOT / "_valid.json"


def valid_indices(os_name: str):
    """Preset indexes whose WebGL entry exists in Camoufox's database.

    Presets outside this list crash the browser with:
      No WebGL data found for vendor ... and renderer ...
    """
    if not VALID_CACHE.exists():
        return None
    try:
        return json.loads(VALID_CACHE.read_text()).get(os_name)
    except Exception:
        return None


# ---- host screen geometry ---------------------------------------------------
# Taskbar/panel/dock height per OS, matching Camoufox fix_screen_no_taskbar().
TASKBAR = {"macos": 25, "windows": 40, "linux": 27}


def screen_geometry(os_name, preset, headless=False):
    """Use the attached display for screen.* and leave window.* native."""
    s = preset.get("screen", {}) or {}
    sw = int(s.get("width") or 1920)
    sh = int(s.get("height") or 1080)

    if not headless:
        try:
            from camoufox.utils import get_screen_cons
            d = get_screen_cons(False)
            if d and d.max_width and d.max_height:
                sw = int(d.max_width)
                sh = int(d.max_height)
        except Exception:
            pass

    tb = TASKBAR.get(os_name, 27)
    ah = max(sh - tb, 400)
    ah = min(ah, sh - 1) if sh > 1 else ah
    return {
        "screen.width": sw, "screen.height": sh,
        "screen.availWidth": sw, "screen.availHeight": ah,
    }


def preset_items(os_name):
    """(preset_id, preset) pairs: bundled valid pool + extra GPUs.

    Extra entries carry their own WebGL data, so they are valid by
    construction and bypass _valid.json."""
    pres = load_presets().get("presets", {})
    pool = pres.get(os_name) or pres.get("windows")
    good = valid_indices(os_name) or list(range(len(pool)))
    items = [(f"{os_name}:{i}", pool[i]) for i in good]
    if extra_presets is not None:
        for g in extra_presets(os_name):
            pid, p = g.get("preset_id"), g.get("preset")
            if pid and isinstance(p, dict):
                items.append((pid, p))
    return items


def _gpu_key(text):
    """Normalise a GPU query/value so 'gtx480' matches 'GTX 480'."""
    return re.sub(r"[^a-z0-9]", "", str(text).lower())


def pick_preset(os_name: str, min_screen=(1600, 900), gpu=None) -> dict:
    """Pick a random VALID preset, preferring ones not used by other profiles.

    Prefers presets whose screen is at least min_screen so the browser
    viewport fills the window nicely on modern monitors (small presets like
    1184x666 render a tiny page inside a big window). Presets are still
    real-device fingerprints; only the size class is preferred.

    `gpu` filters by a case-insensitive substring of the WebGL vendor or
    renderer, which is how an extra GPU from extras/gpus.json is selected."""
    items = preset_items(os_name)
    if gpu:
        q = _gpu_key(gpu)
        items = [(pid, p) for pid, p in items
                 if q in _gpu_key(json.dumps(p.get("webgl", {}), default=str))]

    used = set()
    for f in ROOT.glob("*/fingerprint.json"):
        try: used.add(json.loads(f.read_text()).get("preset_id"))
        except Exception: pass

    avail = [(pid, p) for pid, p in items if pid not in used]
    if not avail:
        if gpu:
            raise ValueError(f"no unused {os_name} preset matches --gpu {gpu!r}")
        raise ValueError(f"no unused {os_name} fingerprint presets remain")
    # prefer big-screen presets (viewport fills the window on modern displays)
    big = [(pid, p) for pid, p in avail
           if (p.get("screen", {}).get("width", 0) >= min_screen[0]
               and p.get("screen", {}).get("height", 0) >= min_screen[1])]
    pid, p = random.choice(big or avail)
    return {"preset_id": pid, "preset": p}


def list_profiles():
    if not ROOT.exists():
        print("no profiles yet"); return
    rows = []
    for d in sorted(ROOT.iterdir()):
        f = d / "fingerprint.json"
        if not f.exists(): continue
        m = json.loads(f.read_text())
        n = m["preset"].get("navigator", {})
        rows.append((d.name, m.get("os"), m.get("preset_id"),
                     n.get("hardwareConcurrency"), n.get("platform"),
                     m.get("proxy_port")))
    print(f"{'PROFILE':<12}{'OS':<10}{'preset':<14}{'cores':<7}{'platform':<10}port")
    print("-"*62)
    for r in rows:
        print(f"{r[0]:<12}{r[1]:<10}{str(r[2]):<14}{str(r[3]):<7}{str(r[4]):<10}{r[5] or '-'}")
    print(f"\ntotal: {len(rows)} profiles")


# ---------------- proxy helpers ----------------
def split_proxy(url):
    """'http://user:pass@host:port' -> ('http', 'user:pass', 'host:port').
    Accepts URLs with or without a scheme (defaults to http)."""
    url = url.strip()
    m = re.match(r"^(https?|socks5)://(.*)$", url, re.I)
    scheme = m.group(1).lower() if m else "http"
    rest = m.group(2) if m else url
    if "@" in rest:
        userinfo, _, hostport = rest.rpartition("@")
    else:
        userinfo, hostport = "", rest
    return scheme, userinfo, hostport


def resolve_proxy(a, meta):
    """Decide the effective proxy URL for this run (None = no proxy).
    Priority: --noproxy > --proxy-file > --proxy > --port > stored proxy_url
    > stored proxy_port. A local port becomes socks5://127.0.0.1:<port>."""
    if a.noproxy:
        return None
    if a.proxy_file:
        f = pathlib.Path(a.proxy_file).expanduser()
        if not f.exists():
            sys.exit(f"proxy file not found: {f}")
        for line in f.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#"):
                return line
        sys.exit(f"no proxy URL found in {f}")
    if a.proxy:
        return a.proxy
    if a.port:
        return f"socks5://127.0.0.1:{a.port}"
    # fall back to whatever is stored in the profile
    if meta.get("proxy_url"):
        return meta["proxy_url"]
    port = saved_port(meta)
    return f"socks5://127.0.0.1:{port}" if port else None


def store_proxy(a, meta):
    """Persist an explicit proxy choice as the profile default. Returns True
    when meta changed. Only one of proxy_url / proxy_port stays active."""
    if a.noproxy:
        meta.pop("proxy_url", None); meta["proxy_port"] = "__none__"
    elif a.proxy or a.proxy_file:
        meta["proxy_url"] = resolve_proxy(a, meta); meta.pop("proxy_port", None)
    elif a.port:
        meta["proxy_port"] = a.port; meta.pop("proxy_url", None)
    else:
        return False
    return True


def _mask_proxy(url):
    """Hide the password when printing: user:***@host:port"""
    scheme, userinfo, hostport = split_proxy(url)
    if userinfo and ":" in userinfo:
        user = unquote(userinfo.split(":", 1)[0])
        return f"{scheme}://{user}:***@{hostport}"
    return f"{scheme}://{hostport}" if userinfo else url


# ---------------- desktop fonts (AF-005) ----------------
# `cfm-fonts apply` symlinks a real desktop font set into Camoufox's Linux
# persona and records which names now resolve. Read that here.
FONT_MANIFEST_DIR = pathlib.Path.home() / ".local" / "share" / "cfm-fonts"


def desktop_font_names(os_name):
    """Font names the persona can really render, per the cfm-fonts manifest.

    Camoufox's Linux bundle ships only Arimo, Cousine, Tinos and the Noto
    script fonts. A page enumerating the usual desktop names (Arial, DejaVu
    Sans, Liberation Sans, ...) therefore finds *nothing*, which reads as a
    stripped browser rather than a desktop -- see AF-005. cfm-fonts adds the
    missing fonts and writes a manifest; without it this returns [] and
    Camoufox's own behaviour is untouched.
    """
    if os_name != "linux":
        return []
    mp = FONT_MANIFEST_DIR / "linux-desktop.manifest.json"
    try:
        names = json.loads(mp.read_text()).get("font_names") or []
    except Exception:
        return []
    return sorted({n for n in names if isinstance(n, str) and n})


def with_desktop_fonts(kw, os_name):
    """Add the desktop font names to the spoofed font list. Returns the count.

    The full bundle list is used rather than Camoufox's random per-launch
    subset: the subset advertises fewer names than the bundle can render, and
    measured on this host it made *fewer* fonts detectable than not passing a
    list at all (16 vs 29 out of the Linux list). A real desktop's font set
    does not change between sessions either, so a stable list is also the more
    honest model. Verified: 33 detectable, against 29 without the desktop set.
    """
    extra = desktop_font_names(os_name)
    if not extra:
        return 0
    key = {"linux": "lin", "windows": "win", "macos": "mac"}.get(os_name)
    base = []
    try:
        from camoufox.fingerprints import _load_os_fonts
        base = _load_os_fonts().get(key, []) if key else []
    except Exception:
        base = []
    kw["fonts"] = sorted(set(base) | set(extra))
    return len(extra)


def main():
    p = argparse.ArgumentParser(description="Camoufox multi-profile launcher")
    p.add_argument("profile", nargs="?", help="profile name")
    p.add_argument("--port", type=int, default=0,
                   help="local SOCKS5 port (saved as default; omitted = saved default)")
    p.add_argument("--proxy", default=None, help="remote proxy URL: http(s):// or socks5:// [user:pass@]host:port")
    p.add_argument("--proxy-file", default=None, help="read the proxy URL from this file (first non-empty line)")
    p.add_argument("--noproxy", action="store_true",
                   help="run WITHOUT a proxy (real IP) and save that as the default")
    p.add_argument("--os", default=None, choices=OS_LIST, help="OS (random when creating a new profile)")
    p.add_argument("--gpu", default=None,
                   help="only pick a preset whose WebGL vendor/renderer contains this text "
                        "(e.g. gtx480); used to test extra GPUs from extras/gpus.json")
    p.add_argument("--url", default="https://iphey.com")
    p.add_argument("--headless", action="store_true")
    p.add_argument("--new", action="store_true", help="REGENERATE this profile's fingerprint")
    p.add_argument("--gen-only", action="store_true", help="create/refresh the profile WITHOUT launching the browser (safe for batch creation)")
    p.add_argument("--show", action="store_true", help="print the stored identity")
    p.add_argument("--list", action="store_true", help="list all profiles")
    p.add_argument("--win", default=None, help="window size WxH (default 1280x800)")
    p.add_argument("--fresh", action="store_true", help="start a fresh session (drop old tabs)")
    p.add_argument("--fs", dest="force_fullscreen", action="store_true",
                   help="force fullscreen shortly after launch (X11/KWin)")
    p.add_argument("--no-fs", action="store_true", help=argparse.SUPPRESS)
    a = p.parse_args()

    if a.list:
        list_profiles(); return
    if not a.profile:
        p.error("a profile name is required (or use --list)")
    if not valid_name(a.profile):
        p.error(f"invalid profile name {a.profile!r} (allowed: letters, digits, . _ -)")
    if sum(bool(x) for x in (a.port, a.proxy, a.proxy_file, a.noproxy)) > 1:
        p.error("use only one of --port / --proxy / --proxy-file / --noproxy")

    # guard: make sure the Camoufox binary is present
    ok, info = camo_ready()
    if not ok:
        print(f"\n  Camoufox is not ready: {info}")
        print("  Fix:\n    camoufox fetch\n")
        sys.exit(1)

    # extra GPUs are not in Camoufox's bundled webgl_data.db; serve their
    # recorded data before launching.
    if install_sample_webgl_patch is not None:
        install_sample_webgl_patch()

    pdir = ROOT / a.profile
    pdir.mkdir(parents=True, exist_ok=True)
    fpath = pdir / "fingerprint.json"

    is_new = a.new or not fpath.exists()
    if is_new:
        old = json.loads(fpath.read_text()) if fpath.exists() else {}
        if a.os:
            os_name = a.os
            try:
                data = pick_preset(os_name, gpu=a.gpu)
            except ValueError as e:
                sys.exit(f"[!] {e}; choose another OS or free a preset")
        else:
            data = None
            for candidate in random.sample(OS_LIST, len(OS_LIST)):
                try:
                    data = pick_preset(candidate, gpu=a.gpu)
                    os_name = candidate
                    break
                except ValueError:
                    continue
            if data is None:
                sys.exit("[!] No unused fingerprint presets remain"
                         + (f" matching --gpu {a.gpu!r}" if a.gpu else "")
                         + "; choose another OS or free a preset")
        meta = {"profile": a.profile, "os": os_name, **data}
        # --new regenerates the fingerprint only; keep the saved proxy default.
        for k in ("proxy_port", "proxy_url"):
            if k in old:
                meta[k] = old[k]
        write_meta(fpath, meta)
    else:
        meta = json.loads(fpath.read_text())
        os_name = a.os or meta["os"]

    preset = meta["preset"]
    nav = preset.get("navigator", {})

    # Explicit --port/--proxy/--proxy-file/--noproxy become the saved default.
    if store_proxy(a, meta):
        write_meta(fpath, meta)

    # --gen-only: stop here - fingerprint (and proxy) are saved, no launch
    if a.gen_only:
        print(f"[+] {a.profile}  os={os_name}  preset={meta.get('preset_id')}  {'NEW' if is_new else 'stored'}  (gen-only, no launch)")
        return

    runtime_screen = screen_geometry(os_name, preset, headless=a.headless)

    if a.show:
        print(f"profile  : {a.profile}")
        print(f"os       : {os_name}")
        print(f"preset   : {meta.get('preset_id')}")
        print(f"UA       : {nav.get('userAgent')}")
        print(f"platform : {nav.get('platform')}  cores={nav.get('hardwareConcurrency')}")
        print(f"preset screen : {preset.get('screen',{}).get('width')}x{preset.get('screen',{}).get('height')}")
        print(f"runtime screen: {runtime_screen['screen.width']}x{runtime_screen['screen.height']}")
        print(f"webgl    : {json.dumps(preset.get('webgl',{}), default=str)[:140]}")
        if meta.get("proxy_url"):
            pu = _mask_proxy(meta["proxy_url"])
            print(f"proxy    : {pu}  (stored)")
        elif saved_port(meta):
            print(f"proxy    : 127.0.0.1:{meta['proxy_port']}  (stored, wireproxy)")
        else:
            print("proxy    : NONE")
        print(f"created  : {meta.get('created', '(older)')}")
        return

    proxy = resolve_proxy(a, meta)
    ptxt = _mask_proxy(proxy) if proxy else "NONE (real IP!)"

    print(f"[+] {a.profile}  os={os_name}  preset={meta.get('preset_id')}  {'NEW' if is_new else 'stored'}")
    print(f"    UA      : {nav.get('userAgent','')[:70]}")
    print(f"    cores   : {nav.get('hardwareConcurrency')}   monitor: {runtime_screen['screen.width']}x{runtime_screen['screen.height']}")
    print(f"    proxy   : {ptxt}")

    # Firefox preferences. Session restore stays off on purpose: cookies, logins
    # and history persist regardless, and a corrupt recovery file used to hang
    # startup.
    ff_prefs = {
        "browser.startup.page": 0,             # 3 = restore previous session
        "browser.startup.homepage": a.url,
        "browser.sessionstore.resume_from_crash": False,
        "browser.sessionstore.max_tabs_undo": 20,
        "browser.sessionstore.interval": 5000,  # save every 5s
        "browser.tabs.warnOnClose": False,
        "browser.warnOnQuit": False,
        "toolkit.legacyUserProfileCustomizations.stylesheets": True,
    }

    # Default window size = 92% of the REAL monitor (fills the floating rule),
    # instead of a hardcoded 1280x800 which leaves a tiny page in a big window.
    win_w, win_h = 1766, 993
    try:
        from camoufox.utils import get_screen_cons as _gsc
        _d = _gsc(False)
        if _d and _d.max_width and _d.max_height:
            win_w = int(_d.max_width * 0.92)
            win_h = int(_d.max_height * 0.92)
    except Exception:
        pass
    if a.win and "x" in a.win:
        try:
            win_w, win_h = (int(x) for x in a.win.lower().split("x")[:2])
        except Exception:
            pass

    kw = dict(
        persistent_context=True,
        user_data_dir=str(pdir),
        window=(win_w, win_h),
        os=os_name,
        fingerprint_preset=preset,     # key: the same preset on every run
        humanize=True,
        locale="en-US",
        headless=a.headless,
        main_world_eval=True,
        # no_viewport: without it Playwright forces a 1280x720 viewport, so a
        # fullscreen window only renders the page in the top-left corner.
        no_viewport=True,
        # Use the active host display for screen.*. Do not pin window.* so the
        # native viewport follows the actual browser window when it is resized.
        config=runtime_screen,
        i_know_what_im_doing=True,
        firefox_user_prefs=ff_prefs,
    )
    if proxy:
        scheme, userinfo, hostport = split_proxy(proxy)
        kw["proxy"] = {"server": f"{scheme}://{hostport}"}
        enc = f"{scheme}://{hostport}"
        hide = []        # secrets to scrub from error messages
        if userinfo:
            u, _, p = userinfo.partition(":")
            # cfm stores credentials percent-encoded (safe for @ : / # etc.)
            kw["proxy"]["username"] = unquote(u)
            kw["proxy"]["password"] = unquote(p)
            enc = f"{scheme}://{quote(unquote(u), safe='')}:{quote(unquote(p), safe='')}@{hostport}"
            hide = [x for x in (unquote(p), quote(unquote(p), safe=""), p) if x]
        # Resolve the exit IP here instead of geoip=True: Camoufox rebuilds the
        # proxy URL without encoding, so a password containing @ / # : breaks
        # its lookup. Fail closed - never launch with a mismatched geo.
        from camoufox.ip import public_ip
        try:
            kw["geoip"] = public_ip(enc)
        except Exception as e:
            msg = str(e)
            for x in hide:
                msg = msg.replace(x, "***")
            sys.exit(f"[!] proxy {_mask_proxy(proxy)} is not working: "
                     f"{type(e).__name__}: {msg[:160]}")
        print(f"    exit IP : {kw['geoip']}")

        # AF-010: Camoufox computes the right timezone from geoip and writes it
        # to a pref, but the page still reports the HOST timezone -- verified
        # with an explicit config={'timezone': ...} and with a SG proxy, both
        # of which still returned the host's zone. Playwright's own
        # timezone_id DOES work, so set it here from the same geoip lookup.
        # Without this a Singapore proxy next to an Asia/Jakarta clock is a
        # plain VPN tell, and every profile shares the host's zone.
        try:
            from camoufox.geolocation import get_geolocation
            tz = get_geolocation(kw["geoip"]).timezone
            if tz:
                kw["timezone_id"] = tz
                print(f"    timezone: {tz}")
        except Exception as exc:
            print(f"[!] timezone not set ({exc.__class__.__name__}); page will "
                  f"report the host timezone (AF-010)")

    n_fonts = with_desktop_fonts(kw, os_name)
    if n_fonts:
        print(f"    fonts   : +{n_fonts} desktop names (cfm-fonts)")

    with Camoufox(**kw) as ctx:
        # AF-006: WebGL *parameters* are spoofed, but the frame itself is drawn
        # by the physical GPU and readPixels hands it back verbatim -- so every
        # profile on this machine shares one render fingerprint, and it also
        # matches the host's own browser. Perturb just the readback, per
        # profile. Must be installed before the first navigation.
        if cfm_readpixels is not None and cfm_readpixels.enabled():
            try:
                _rp_seed = cfm_readpixels.ensure_seed(pdir)
                cfm_readpixels.install(ctx, _rp_seed)
                print(f"    readPixels: noise on (seed {_rp_seed:08x})")
            except Exception as exc:
                print(f"[!] readPixels noise skipped: {exc.__class__.__name__}: {exc}")

        # persistent_context already opened one window - reuse it, don't create
        # a second one.
        page = ctx.pages[0] if ctx.pages else ctx.new_page()

        # Hyprland/Wayland: move this window to its own empty workspace
        # (e.g. 'cfx:<profile>') so it is not tiled and the viewport keeps the
        # preset size. Runs once per launch, non-blocking.
        if not a.headless and _os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            import threading, subprocess as _sp
            def _own_ws():
                try:
                    # socat-free: uses hyprctl; fails silently otherwise
                    _sp.run(["hyprctl", "dispatch", "movetoworkspacesilent",
                             f"cfx:{a.profile}"],
                            timeout=5, stdout=_sp.DEVNULL, stderr=_sp.DEVNULL)
                except Exception:
                    pass
            threading.Thread(target=_own_ws, daemon=True).start()

        # Fullscreen is opt-in because the X11 helper must wait for the window
        # to appear, which otherwise causes a delayed jump after launch.
        if not a.headless and a.force_fullscreen and not a.no_fs and _os.environ.get("DISPLAY") and not _os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            import threading, subprocess as _sp
            _fs = pathlib.Path.home() / ".local" / "bin" / "cfox-fullscreen.py"
            if _fs.exists():
                def _mkfull():
                    try:
                        _sp.run(["python3", str(_fs), a.profile],
                                timeout=45, stdout=_sp.DEVNULL, stderr=_sp.DEVNULL)
                    except Exception:
                        pass
                threading.Thread(target=_mkfull, daemon=True).start()

        # Unless restoring a session, force the initial URL.
        # goto is retried: a navigation timeout must not kill the browser and
        # the session in use.
        def _goto(url, tries=3):
            for attempt in range(1, tries + 1):
                try:
                    page.goto(url, timeout=60000, wait_until="domcontentloaded")
                    return
                except Exception as exc:
                    if attempt == tries:
                        print(f"[!] goto failed after {tries}x ({exc.__class__.__name__}) - "
                              f"browser stays open, load the page manually")
                        return
                    print(f"[!] goto retry {attempt}/{tries}: {exc.__class__.__name__}")
                    try: page.wait_for_timeout(2000)
                    except Exception: return

        if a.url and a.url != "about:blank" and (a.url != "https://iphey.com" or not page.url or page.url == "about:blank"):
            _goto(a.url)
        else:
            try:
                if not page.url or page.url in ("about:blank", ""):
                    _goto(a.url)
            except Exception:
                pass

        if a.headless:
            return

        if sys.stdin.isatty() and not _os.environ.get("CFM_LAUNCHED"):
            try: input("    [ENTER to close] ")
            except (EOFError, KeyboardInterrupt): pass
        else:
            # Launched in the background (nohup/setsid): stay alive until the
            # window is closed manually.
            print("    background mode - close the window to exit")
            try:
                while True:
                    page.wait_for_timeout(2000)
                    if len(ctx.pages) == 0:
                        break
            except Exception:
                pass


if __name__ == "__main__":
    main()
