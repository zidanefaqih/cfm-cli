#!/usr/bin/env python3
"""Open each profile briefly and check runtime display geometry.

    cfox-verify acc1 acc2 ...
"""
import os, json, re, sys, tempfile
os.environ.setdefault('XDG_CACHE_HOME', os.environ.get('CAMOUFOX_HOME', str(os.path.expanduser('~/.local/share/camoufox'))))
if sys.platform.startswith('linux'):
    os.environ.setdefault('DISPLAY', ':1')
from camoufox.sync_api import Camoufox

src = open(os.path.join(os.path.dirname(os.path.abspath(__file__)), 'cfox')).read()
ns = {}
exec(src[src.index('TASKBAR ='):src.index('def pick_preset')], ns)
sg = ns['screen_geometry']

JS = ("()=>({sw:screen.width,sh:screen.height,aw:screen.availWidth,ah:screen.availHeight,"
      "ow:outerWidth,oh:outerHeight,iw:innerWidth,ih:innerHeight,"
      "dw:document.documentElement.clientWidth,dh:document.documentElement.clientHeight})")

print(f"  {'PROFILE':<7}{'screen':<12}{'avail':<12}{'outer':<12}{'inner':<12}check")
allok = True
for name in sys.argv[1:]:
    if not re.match(r'^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$', name) or '..' in name:
        print(f'  {name}: invalid profile name, skipped'); allok = False; continue
    profile_file = os.path.join(os.path.expanduser('~/camfox-profiles'), name, 'fingerprint.json')
    with open(profile_file) as profile_stream:
        m = json.load(profile_stream)
    cfg = sg(m['os'], m['preset'], headless=False)
    with tempfile.TemporaryDirectory(prefix=f'cfm-verify-{name}-') as tmp:
        kw = dict(headless=False, persistent_context=True, user_data_dir=tmp, os=m['os'],
                  fingerprint_preset=m['preset'], main_world_eval=True, window=(1280, 800),
                  no_viewport=True, config=cfg, i_know_what_im_doing=True, locale="en-US")
        with Camoufox(**kw) as ctx:
            pg = ctx.pages[0] if ctx.pages else ctx.new_page()
            pg.goto("about:blank")
            v = pg.evaluate(JS)
    ck = {
        'screen==monitor': v['sw'] == cfg['screen.width'] and v['sh'] == cfg['screen.height'],
        'avail<screen': v['ah'] < v['sh'] and v['aw'] <= v['sw'],
        'inner<=outer': v['ih'] <= v['oh'] and v['iw'] <= v['ow'],
        'client==inner': abs(v['dh'] - v['ih']) <= 2 and abs(v['dw'] - v['iw']) <= 2,
    }
    ok = all(ck.values())
    allok &= ok
    bad = [k for k, x in ck.items() if not x]
    print(f"  {name:<7}{v['sw']}x{v['sh']:<8}{v['aw']}x{v['ah']:<8}"
          f"{v['ow']}x{v['oh']:<7}{v['iw']}x{v['ih']:<7}"
          f"{'OK' if ok else 'LEAK: ' + ','.join(bad)}")
print()
print(f"  {'=> ALL PROFILES OK' if allok else '=> LEAK STILL PRESENT'}")
