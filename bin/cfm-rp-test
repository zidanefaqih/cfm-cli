#!/usr/bin/env python3
"""Check that each profile renders WebGL differently (AF-006).

Runs a fixed WebGL shader, reads it back with `gl.readPixels` exactly like a
fingerprinting script does, and prints the hash. Use it to confirm three
things:

  * the same profile always gives the same hash      (stable)
  * two profiles give different hashes               (unique)
  * with --no-patch, every profile gives one hash    (the leak being fixed)

  cfm-rp-test lin89 lin94
  cfm-rp-test lin89 lin94 --no-patch
"""
import argparse
import json
import os
import pathlib
import sys
import tempfile

_BIN = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(_BIN))
os.environ.setdefault("XDG_CACHE_HOME", str(pathlib.Path.home() / ".local" / "share" / "camoufox"))

from camoufox.sync_api import Camoufox  # noqa: E402

try:
    import cfm_readpixels as RP
except Exception:  # pragma: no cover
    RP = None

ROOT = pathlib.Path.home() / "camfox-profiles"

PROBE = r"""() => {
const c = document.createElement('canvas'); c.width = 300; c.height = 150;
const gl = c.getContext('webgl', {preserveDrawingBuffer: true, antialias: false});
const vs = gl.createShader(gl.VERTEX_SHADER);
gl.shaderSource(vs, "attribute vec2 p;varying vec2 v;void main(){v=p;gl_Position=vec4(p,0.0,1.0);}");
gl.compileShader(vs);
const fs = gl.createShader(gl.FRAGMENT_SHADER);
gl.shaderSource(fs, `precision highp float;varying vec2 v;
float g(float x){for(int i=0;i<40;i++){x=x*1.0000001+sin(x*1.61803)+cos(x*0.70710);}return x;}
void main(){float a=g(v.x*17.3)+g(v.y*11.7);vec3 col=vec3(fract(a*137.13),fract(a*271.7),fract(a*913.3));
 gl_FragColor=vec4(col,1.0);}`);
gl.compileShader(fs);
const pr = gl.createProgram(); gl.attachShader(pr, vs); gl.attachShader(pr, fs);
gl.linkProgram(pr); gl.useProgram(pr);
const b = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, b);
gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1,3,-1,-1,3]), gl.STATIC_DRAW);
const l = gl.getAttribLocation(pr, "p"); gl.enableVertexAttribArray(l);
gl.vertexAttribPointer(l, 2, gl.FLOAT, false, 0, 0);
gl.viewport(0, 0, 300, 150); gl.drawArrays(gl.TRIANGLES, 0, 3);
const px = new Uint8Array(300 * 150 * 4);
gl.readPixels(0, 0, 300, 150, gl.RGBA, gl.UNSIGNED_BYTE, px);
let h = 5381; for (let i = 0; i < px.length; i++) h = ((h * 33) ^ px[i]) >>> 0;
const d = gl.getExtension('WEBGL_debug_renderer_info');
return {hash: h, renderer: gl.getParameter(d.UNMASKED_RENDERER_WEBGL)};}"""


def run(profile, patch):
    pdir = ROOT / profile
    fp = pdir / "fingerprint.json"
    if not fp.exists():
        sys.exit(f"[!] no such profile: {profile} ({fp} missing)")
    meta = json.loads(fp.read_text())
    seed = RP.ensure_seed(pdir) if RP else 0
    kw = dict(
        persistent_context=True, user_data_dir=tempfile.mkdtemp(),
        os=meta.get("os", "linux"), fingerprint_preset=meta["preset"],
        headless=True, main_world_eval=True, no_viewport=True,
        i_know_what_im_doing=True, locale="en-US",
        config={"screen.width": 1920, "screen.height": 1080},
    )
    with Camoufox(**kw) as ctx:
        if patch and RP:
            RP.install(ctx, seed)
        page = ctx.pages[0] if ctx.pages else ctx.new_page()
        page.goto("https://example.com", timeout=60000)
        out = page.evaluate(PROBE)
    out["seed"] = seed
    return out


def main():
    ap = argparse.ArgumentParser(description="verify per-profile WebGL render uniqueness")
    ap.add_argument("profiles", nargs="+", help="one or more profile names")
    ap.add_argument("--no-patch", action="store_true",
                    help="control run: skip the readback noise (should give ONE hash for every profile)")
    a = ap.parse_args()
    patch = not a.no_patch
    if patch and RP is None:
        sys.exit("[!] cfm_readpixels.py not found next to this script")

    print(f"mode: {'noise ON (default)' if patch else 'NOISE OFF (control)'}\n")
    res = {}
    for name in a.profiles:
        r = run(name, patch)
        res[name] = r["hash"]
        print(f"  {name:12} seed={r['seed']:08x}  hash={r['hash']:<12} renderer={r['renderer']}")
    print()
    if len(res) > 1:
        uniq = len(set(res.values()))
        print(f"  profil diuji   : {len(res)}")
        print(f"  hash unik      : {uniq}")
        if patch:
            print(f"  -> {'OK, tiap profil beda' if uniq == len(res) else 'GAGAL, ada hash yang sama'}")
        else:
            print(f"  -> {'OK, semua sama (inilah kebocoran yang diperbaiki)' if uniq == 1 else 'tak terduga'}")
    if patch:
        print("\n  catatan: nilai ini hanya berubah kalau situs memanggil readPixels di frame utama.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
